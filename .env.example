# ==========================================================================
# Extractor_texto_tiktok - Configuracion
# Copia este archivo a  .env  y rellena tus valores.
#   copy .env.example .env       (Windows)
# El archivo .env NUNCA se sube a Git (esta en .gitignore).
# ==========================================================================

# --- Proveedor de IA para traduccion y analisis tecnico -----------------
# Valores: openai | gemini | deepseek | mock
#   gemini -> unico con capa gratuita (Google AI Studio)
#   mock   -> proveedor simulado offline (sin coste, sin analisis real)
AI_PROVIDER=gemini

# Modelo concreto del proveedor. Dejar vacio = usar el modelo por defecto
# recomendado para el proveedor elegido. Ejemplos (los proveedores retiran
# modelos con el tiempo; si uno deja de funcionar, pon aqui el nombre nuevo):
#   openai   -> gpt-4o-mini
#   gemini   -> gemini-3.6-flash   (tambien vale el alias gemini-flash-latest)
#   deepseek -> deepseek-chat
AI_MODEL=

# --- Claves de API (solo hace falta la del proveedor que uses) ----------
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Transcripcion -----------------------------------------------------
# Backend:  local  -> openai-whisper en tu PC (offline, gratis)
#           openai_api -> API de OpenAI (de pago, necesita OPENAI_API_KEY)
TRANSCRIPTION_BACKEND=local

# Modelo de Whisper (backend local).
# Valores: tiny | base | small | medium | large | large-v2 | large-v3
#   tiny/base  -> muy rapido, menos preciso
#   small      -> equilibrio recomendado
#   medium/large -> mas preciso, mucho mas lento y con mas RAM
TRANSCRIPTION_MODEL=small

# --- Carpetas --------------------------------------------------------
OUTPUT_DIRECTORY=output
TEMP_DIRECTORY=temp
LOGS_DIRECTORY=logs

# --- Red / limites --------------------------------------------------
NETWORK_TIMEOUT=30
MAX_VIDEO_MB=200

# --- Comportamiento -------------------------------------------------
# Si el proveedor elegido no tiene clave y esto es true, usa 'mock'
# en lugar de fallar. Util para probar el pipeline sin claves.
ALLOW_MOCK_FALLBACK=false

# Conservar la carpeta temporal cuando un procesamiento falla (debug).
KEEP_TEMP_ON_ERROR=true
