# ==========================================================================
# Extractor_texto_tiktok - Configuracion
# Copia este archivo a  .env  y rellena tus valores.
#   copy .env.example .env       (Windows)
# El archivo .env NUNCA se sube a Git (esta en .gitignore).
# ==========================================================================

# --- Proveedor de IA para traduccion y analisis tecnico -----------------
# Valores: openai | gemini | deepseek | claude_cli | mock
#   gemini     -> unico con capa gratuita (Google AI Studio)
#   claude_cli -> Claude via el CLI de Claude Code (`claude -p`), usando tu
#                 suscripcion de Claude ya iniciada en el equipo; no necesita
#                 clave de API. Requiere: npm install -g @anthropic-ai/claude-code
#                 y haber ejecutado `claude` una vez para iniciar sesion.
#   mock       -> proveedor simulado offline (sin coste, sin analisis real)
AI_PROVIDER=gemini

# Modelo concreto del proveedor. Dejar vacio = usar el modelo por defecto
# recomendado para el proveedor elegido. Ejemplos (los proveedores retiran
# modelos con el tiempo; si uno deja de funcionar, pon aqui el nombre nuevo):
#   openai   -> gpt-4o-mini
#   gemini   -> gemini-3.6-flash   (tambien vale el alias gemini-flash-latest)
#   deepseek -> deepseek-chat
#   claude_cli -> sonnet   (alias del CLI; tambien opus, haiku o un id completo)
AI_MODEL=

# Modelo de reserva SOLO para Gemini: si el modelo principal responde 503
# "sobrecargado por alta demanda" y se agotan los reintentos, se prueba una
# vez con este modelo antes de degradar el informe. Deja vacio para
# desactivar el fallback. Flash-Lite suele tener mas margen libre que Flash.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Solo claude_cli: comando o ruta del CLI de Claude Code, y cuanto esperar
# como maximo cada llamada (en segundos; el CLI es mas lento que una API HTTP).
CLAUDE_CLI_CMD=claude
CLAUDE_CLI_TIMEOUT=600

# --- Formato del informe --------------------------------------------------
# Valores: html | markdown | both
#   html     -> pagina autonoma con estilos y graficos SVG (para leer tu)
#   markdown -> texto estructurado con metadatos YAML (ideal para darselo a
#               otra IA o guardarlo en notas / repositorios)
#   both     -> genera los dos
REPORT_FORMAT=html

# --- Claves de API (solo hace falta la del proveedor que uses) ----------
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Transcripcion -----------------------------------------------------
# Backend:  local  -> openai-whisper en tu PC (offline, gratis)
#           openai_api -> API de OpenAI (de pago, necesita OPENAI_API_KEY)
TRANSCRIPTION_BACKEND=local

# Modelo de Whisper (backend local).
# Valores: tiny | base | small | medium | large | large-v2 | large-v3
#   tiny/base  -> muy rapido, menos preciso
#   small      -> equilibrio recomendado
#   medium/large -> mas preciso, mucho mas lento y con mas RAM
TRANSCRIPTION_MODEL=small

# --- Carpetas --------------------------------------------------------
OUTPUT_DIRECTORY=output
TEMP_DIRECTORY=temp
LOGS_DIRECTORY=logs

# --- Red / limites --------------------------------------------------
NETWORK_TIMEOUT=30
MAX_VIDEO_MB=200

# --- Comportamiento -------------------------------------------------
# Si el proveedor elegido no tiene clave y esto es true, usa 'mock'
# en lugar de fallar. Util para probar el pipeline sin claves.
ALLOW_MOCK_FALLBACK=false

# Conservar la carpeta temporal cuando un procesamiento falla (debug).
KEEP_TEMP_ON_ERROR=true
